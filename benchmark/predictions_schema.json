{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRONTIERE HOLDOUT predictions v1",
  "type": "object",
  "required": ["schema_version", "method", "method_version", "cases"],
  "properties": {
    "schema_version": {"const": "holdout-predictions-v1"},
    "method": {"type": "string", "minLength": 1},
    "method_version": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["code", "routes", "resource_forms", "resources", "evidence_urls", "elapsed_seconds", "analyst_minutes", "verification_minutes", "notes"],
        "properties": {
          "code": {"type": "string", "pattern": "^H(0[1-9]|10)$"},
          "routes": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
          "resource_forms": {"type": "array", "items": {"type": "string"}, "maxItems": 4},
          "resources": {"type": "array", "items": {"type": "string"}},
          "evidence_urls": {"type": "array", "items": {"type": "string"}},
          "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
          "analyst_minutes": {"type": "integer", "minimum": 0},
          "verification_minutes": {"type": "integer", "minimum": 0},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
