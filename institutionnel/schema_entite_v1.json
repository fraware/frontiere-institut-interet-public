{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontiere.example/schema/institution-v1",
  "title": "Entité institutionnelle FRONTIÈRE",
  "type": "object",
  "required": ["id", "nom_officiel", "famille", "etat", "provenance", "observe_le"],
  "properties": {
    "id": {"type": "string", "pattern": "^FRONTIERE-INST-[A-Z0-9-]+$"},
    "nom_officiel": {"type": "string", "minLength": 1},
    "sigle": {"type": ["string", "null"]},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "famille": {"type": "string"},
    "type_institutionnel": {"type": ["string", "null"]},
    "nature_juridique": {"type": ["string", "null"]},
    "personnalite_morale": {"type": ["boolean", "null"]},
    "etat": {
      "type": "string",
      "enum": ["ACTIF", "TRANSFORME", "FUSIONNE", "SUPPRIME", "INCONNU"]
    },
    "identifiants": {
      "type": "object",
      "additionalProperties": {"type": ["string", "array", "null"]}
    },
    "parent_id": {"type": ["string", "null"]},
    "tutelles": {"type": "array", "items": {"type": "string"}},
    "territoires": {"type": "array", "items": {"type": "string"}},
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["texte", "source_id"],
        "properties": {
          "texte": {"type": "string"},
          "source_id": {"type": "string"},
          "nature": {"type": "string", "enum": ["PUBLIEE", "ANALYTIQUE"]},
          "valide_depuis": {"type": ["string", "null"]},
          "valide_jusqua": {"type": ["string", "null"]}
        }
      }
    },
    "responsables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fonction", "source_id"],
        "properties": {
          "fonction": {"type": "string"},
          "nom": {"type": ["string", "null"]},
          "prenom": {"type": ["string", "null"]},
          "source_id": {"type": "string"},
          "valide_depuis": {"type": ["string", "null"]},
          "valide_jusqua": {"type": ["string", "null"]}
        }
      }
    },
    "coordonnees": {"type": "array", "items": {"type": "object"}},
    "capacites": {"type": "array", "items": {"type": "object"}},
    "fondements_juridiques": {"type": "array", "items": {"type": "object"}},
    "budget": {"type": "array", "items": {"type": "object"}},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "collecte_le"],
        "properties": {
          "source_id": {"type": "string"},
          "identifiant_source": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]},
          "collecte_le": {"type": "string"},
          "empreinte": {"type": ["string", "null"]}
        }
      }
    },
    "valide_depuis": {"type": ["string", "null"]},
    "valide_jusqua": {"type": ["string", "null"]},
    "observe_le": {"type": "string"}
  },
  "additionalProperties": true
}
