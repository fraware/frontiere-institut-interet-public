{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontiere.example/schema/territoire-v1",
  "title": "Territoire de référence FRONTIÈRE",
  "type": "object",
  "required": [
    "id",
    "nom_officiel",
    "type_territoire",
    "code",
    "identifiants",
    "reference_le",
    "provenance",
    "observe_le"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^FRONTIERE-TERR-COG-[A-Z0-9-]+$"},
    "nom_officiel": {"type": "string", "minLength": 1},
    "type_territoire": {
      "type": "string",
      "enum": ["REG", "DEP", "ARR", "CAN", "COM", "ARM", "COMA", "COMD", "COMER", "COMER-COM"]
    },
    "code": {"type": "string", "minLength": 1},
    "identifiants": {"type": "object"},
    "reference_le": {"type": "string"},
    "millesime": {"type": "string"},
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "identifiant_source", "collecte_le", "empreinte"],
        "properties": {
          "source_id": {"type": "string"},
          "identifiant_source": {"type": "string"},
          "url": {"type": ["string", "null"]},
          "collecte_le": {"type": "string"},
          "empreinte": {"type": "string"}
        }
      }
    },
    "observe_le": {"type": "string"},
    "source_insee": {"type": "object"}
  },
  "additionalProperties": true
}