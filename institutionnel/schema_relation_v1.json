{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frontiere.example/schema/relation-institutionnelle-v1",
  "title": "Relation institutionnelle FRONTIÈRE",
  "type": "object",
  "required": ["id", "source_entite", "type_relation", "cible_entite", "provenance", "observe_le"],
  "properties": {
    "id": {"type": "string"},
    "source_entite": {"type": "string"},
    "type_relation": {
      "type": "string",
      "enum": [
        "DEPEND_DE",
        "TUTELLE_DE",
        "FINANCE",
        "CONTROLE",
        "NOMME",
        "DIRIGE",
        "OPERE",
        "PARTICIPE_A",
        "CO_TUTELLE",
        "COMPETENT_SUR",
        "IMPLANTE_DANS",
        "SUCCEDE_A",
        "FUSIONNE_AVEC",
        "TRANSFERE_COMPETENCE_A",
        "COOPERE_AVEC",
        "DETIENT_CAPACITE",
        "MOBILISABLE_PAR"
      ]
    },
    "cible_entite": {"type": "string"},
    "qualificatifs": {"type": "object"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "valide_depuis": {"type": ["string", "null"]},
    "valide_jusqua": {"type": ["string", "null"]},
    "observe_le": {"type": "string"},
    "statut_validation": {
      "type": "string",
      "enum": ["VALIDE", "A_VALIDER", "REJETE"]
    }
  },
  "additionalProperties": true
}
