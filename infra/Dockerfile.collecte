FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_ROOT_USER_ACTION=ignore

WORKDIR /opt/frontiere
RUN python -m pip install --no-cache-dir "sqlalchemy>=2.0,<3" \
    && mkdir -p /opt/frontiere/app /opt/frontiere/scripts /var/lib/frontiere \
    && useradd --system --uid 10001 --home-dir /var/lib/frontiere frontiere \
    && chown -R frontiere:frontiere /var/lib/frontiere

COPY app/__init__.py app/plateforme_boamp.py app/collecteur_boamp_continu.py app/plateforme_emplois.py app/collecteur_emplois_continu.py /opt/frontiere/app/
COPY scripts/collecter_besoins_publics.py scripts/sonder_structure_offres_publiques.py scripts/extraire_offres_publiques.py scripts/collecter_catalogues_decp.py scripts/sonder_ressource_decp_aife.py scripts/sonder_lot_decp_dgfip.py scripts/ingerer_fichier_decp_json.py scripts/ingerer_fichier_decp_xml.py scripts/indexer_attributions_decp_sqlite.py scripts/consolider_attributions_decp.py /opt/frontiere/scripts/
COPY app/collecteur_decp_continu.py /opt/frontiere/app/

USER frontiere
VOLUME ["/var/lib/frontiere"]

CMD ["python", "-m", "app.collecteur_boamp_continu", "--base", "sqlite:////var/lib/frontiere/avis_boamp.sqlite3", "--repertoire", "/var/lib/frontiere/releves", "--suivre", "--intervalle", "1800"]
